# Path to a Firebase service account JSON key (never commit the key).
# Relative paths resolve from tools/artie-bulk-tool/.
# If unset, the tool looks for ../../scripts/serviceAccountKey.json, then ADC.
GOOGLE_APPLICATION_CREDENTIALS=../../scripts/serviceAccountKey.json

# Optional override; defaults to pygmalions-specs.
FIREBASE_PROJECT_ID=pygmalions-specs

# Cloud Run URL for generateInventoryGarments (required for --processingMode=active).
# Token audience defaults to this URL. The service account must have Cloud Run Invoker.
GENERATE_INVENTORY_GARMENTS_URL=https://generateinventorygarments-<hash>-uc.a.run.app

# Optional. Only set if the OIDC audience must differ from the request URL.
# GENERATE_INVENTORY_GARMENTS_AUDIENCE=https://generateinventorygarments-<hash>-uc.a.run.app
