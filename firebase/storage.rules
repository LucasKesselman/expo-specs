rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Client staging for digital/physical design create flows.
    // Flat files only: _temp/{uid}/designAsset.ext, previewImage.ext, original.jpg, etc.
    match /_temp/{userId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && !fileName.matches('.*[\\\\/].*');
    }

    // Everything else stays admin/functions-only by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
